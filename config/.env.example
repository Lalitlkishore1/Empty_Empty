# GalaxyOne deployment environment inventory.
#
# This file is not loaded by WordPress or GalaxyOne at runtime. Copy its
# non-secret values into the deployment system's private configuration store.
# Do not commit any copied environment file or production credential.

GALAXYONE_ENVIRONMENT=staging
GALAXYONE_PUBLIC_URL=https://staging.example.invalid
GALAXYONE_WORDPRESS_URL=https://staging.example.invalid
GALAXYONE_HEALTHCHECK_PATH=/wp-json/
GALAXYONE_BACKUP_RETENTION_DAYS=30
GALAXYONE_CRON_INTERVAL_MINUTES=5
GALAXYONE_CACHE_BYPASS_PATHS=/cart,/checkout,/my-account,/wp-admin
GALAXYONE_TRANSACTIONAL_MAIL_FROM_ADDRESS=operations@example.invalid
GALAXYONE_TRANSACTIONAL_MAIL_FROM_NAME=GalaxyOne
